# Configurações da aplicação
APP_NAME=labia-chat
APP_ENV=development
APP_DEBUG=true

# Configurações de CORS
CORS_ALLOW_ORIGINS=http://localhost:3000,https://ai-scope.cbpf.br

# Configurações do ADSS (AI-Scope)
ADSS_BASE_URL=https://ai-scope.cbpf.br/adss/v1
ADSS_REQUIRED_ROLE=chat_vllm
ADSS_AUTH_CACHE_TTL_SECONDS=300
ADSS_TIMEOUT_SECONDS=10

# Configurações do banco de dados (MVP 2)
DATABASE_URL=postgresql+asyncpg://labia_chat:labia_chat@localhost:5432/labia_chat

# Configurações do vLLM (MVP 4)
# VLLM_BASE_URL=http://localhost:8000
# VLLM_DEFAULT_MODEL=qwen-coder-next